{
  "name": "glee-fully-chai-chasers",
  "version": "0.1.0",
  "type": "module",
  "description": "A free, fan-made cascading-reels game starring Joey & Phoebe. Original art, fictional currency, real love.",
  "scripts": {
    "dev": "vite",
    "test": "vitest run src",
    "build": "node scripts/check-cdn-urls.mjs && tsc --noEmit && vite build && node scripts/check-cdn-urls.mjs --root=dist",
    "preview": "vite preview",
    "assets:generate": "node scripts/generate-assets.mjs",
    "validate:assets": "node scripts/validate-assets.mjs",
    "validate:hand-svg": "node scripts/check-treat-time-hand-svg.mjs",
    "validate:symbol-pays": "node scripts/check-symbol-reference-pays.mjs",
    "validate:symbol-reels": "node scripts/check-symbol-reference-reels.mjs",
    "validate:canvas-iframes": "node scripts/check-canvas-iframe-registry.mjs",
    "validate:scene-coverage": "node scripts/check-scene-gallery-coverage.mjs",
    "validate:dead-exports": "node scripts/check-dead-exports.mjs",
    "validate:dead-css": "node scripts/check-dead-css.mjs",
    "validate:keepsake-size": "node scripts/check-keepsake-constellation-size.mjs",
    "validate:cabinet-strips": "python3 scripts/add-cabinet-strips.py --validate",
    "validate:cdn": "node scripts/check-cdn-urls.mjs",
    "test:watch": "vitest"
  },
  "private": true,
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@tailwindcss/vite": "catalog:",
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "tailwindcss": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "^4.1.10"
  }
}
